<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Dianty.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Dianty.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Dianty">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt"/>
    </Window.SystemBackdrop>

    <controls:TemplateContentControl
        x:Name="_rootElement" Loaded="RootElement_Loaded" PointerEntered="RootElement_PointerEntered"
        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
        TemplateContent="{x:Bind TemplateContent}" SelectedTemplate="{x:Bind ViewModel.IsLoaded, Mode=OneWay}">
        <controls:TemplateContentControl.ContentTransitions>
            <TransitionCollection>
                <!--<AddDeleteThemeTransition/>-->
                <!--<PaneThemeTransition Edge="Bottom"/>-->
                <PopupThemeTransition/>
            </TransitionCollection>
        </controls:TemplateContentControl.ContentTransitions>
    </controls:TemplateContentControl>
</Window>
