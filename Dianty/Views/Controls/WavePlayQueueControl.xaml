<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Dianty.Views.Controls.WavePlayQueueControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Dianty.Views.Controls"
    xmlns:txt="using:Dianty.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <local:WavePlayQueueListView
            x:Name="ListViewA" Padding="12,0,12,20"
            Header="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.WavesPageText.ChannelAQueueSwitchHeader, Mode=OneWay}"
            IsChannelEnabled="{x:Bind ViewModel.IsChannelEnabledA, Mode=TwoWay}"
            WavePlayingItemsSource="{x:Bind ViewModel.WavePlayingItemsA}"
            PlaybackModeItemsSource="{x:Bind ViewModel.WavePlaybackModeItems}"
            SelectedPlaybackMode="{x:Bind ViewModel.WavePlaybackModeA, Mode=TwoWay}"
            WaveIntervalItemsSource="{x:Bind ViewModel.WaveIntervalItems}"
            SelectedWaveInterval="{x:Bind ViewModel.WaveIntervalA, Mode=TwoWay}"
            PlayWaveCommand="{x:Bind ViewModel.PlayWaveACommand}"
            RemoveWaveCommand="{x:Bind ViewModel.RemovePlayingItemACommand}"
            ClearPlayingItemsCommand="{x:Bind ViewModel.ClearPlayingItemsACommand}"/>
        <local:WavePlayQueueListView
            x:Name="ListViewB" Grid.Column="1" Padding="12,0,12,20"
            Header="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.WavesPageText.ChannelBQueueSwitchHeader, Mode=OneWay}"
            IsChannelEnabled="{x:Bind ViewModel.IsChannelEnabledB, Mode=TwoWay}"
            WavePlayingItemsSource="{x:Bind ViewModel.WavePlayingItemsB}"
            PlaybackModeItemsSource="{x:Bind ViewModel.WavePlaybackModeItems}"
            SelectedPlaybackMode="{x:Bind ViewModel.WavePlaybackModeB, Mode=TwoWay}"
            WaveIntervalItemsSource="{x:Bind ViewModel.WaveIntervalItems}"
            SelectedWaveInterval="{x:Bind ViewModel.WaveIntervalB, Mode=TwoWay}"
            PlayWaveCommand="{x:Bind ViewModel.PlayWaveBCommand}"
            RemoveWaveCommand="{x:Bind ViewModel.RemovePlayingItemBCommand}"
            ClearPlayingItemsCommand="{x:Bind ViewModel.ClearPlayingItemsBCommand}"/>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinimalModeThresholdWidth}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- NavigationView.DisplayMode != Minimal -->
                        <Setter Target="ListViewA.Margin" Value="12,0,0,0"/>
                        <Setter Target="ListViewB.Margin" Value="0,0,12,0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
