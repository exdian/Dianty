<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Dianty.Views.Controls.QrCodeButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Button
            x:Name="DisplayButton" ToolTipService.ToolTip="查看二维码" Click="OnDisplayButtonClick"
            Content="&#xED14;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="20" Padding="4.67"/>
        <TeachingTip x:Name="_qrCodeTip" Target="{x:Bind DisplayButton}" PreferredPlacement="Bottom" CloseButtonContent="隐藏">
            <TeachingTip.Content>
                <Border Background="Black">
                    <Viewbox>
                        <Path
                            Data="{x:Bind QrCodeGeometry, Mode=OneWay}"
                            Fill="White"/>
                    </Viewbox>
                </Border>
            </TeachingTip.Content>
        </TeachingTip>
    </Grid>
</UserControl>
