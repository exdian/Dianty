<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Dianty.Views.Controls.GamesPageContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Dianty.ViewModels"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:txt="using:Dianty.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer x:Name="RootScrollViewer" Padding="12,0" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
        <StackPanel Spacing="{StaticResource CommonCardSpacing}" Margin="0,0,0,24">
            <StackPanel.ChildrenTransitions>
                <RepositionThemeTransition />
            </StackPanel.ChildrenTransitions>
            <TextBlock
                Text="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.GamesPageText.OverviewItemsHeader, Mode=OneWay}"
                Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,2,0,4"/>
            <Grid
                Padding="16,12" CornerRadius="{ThemeResource ControlCornerRadius}"
                Background="{ThemeResource CardBackgroundFillColorDefault}"
                BorderBrush="{ThemeResource CardStrokeColorDefault}" BorderThickness="1">
                <Grid.Shadow>
                    <ThemeShadow />
                </Grid.Shadow>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.GamesPageText.EnabledGameCountLabel, Mode=OneWay}" />
                <TextBlock
                    Grid.Row="1" Grid.Column="0"
                    Text="{x:Bind ViewModel.EnabledGameCount, Mode=OneWay}" FontSize="20" FontWeight="Bold" />
                <TextBlock
                    Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.GamesPageText.OutputStrengthLabel, Mode=OneWay}" />
                <TextBlock
                    Grid.Row="1" Grid.Column="1"
                    Text="{x:Bind ViewModel.OutputStrength, Mode=OneWay}" FontSize="20" FontWeight="Bold" />
            </Grid>
            <toolkit:SettingsExpander
                Header="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.GamesPageText.OutputModeCardHeader, Mode=OneWay}"
                Description="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.GamesPageText.OutputModeCardDescription, Mode=OneWay}">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE9F5;"/>
                </toolkit:SettingsExpander.HeaderIcon>
                <ComboBox
                    PlaceholderText="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.GamesPageText.OutputModePlaceholderText, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.OutputModeSelectionItems, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedOutputMode, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:OutputModeSelectionItem">
                            <TextBlock Text="{x:Bind Description}" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard
                        Header="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.GamesPageText.ManualSwitchCardHeader, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsAutoStartStop, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE815;"/>
                        </toolkit:SettingsCard.HeaderIcon>
                        <ToggleButton
                            Content="&#xE7E8;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18"
                            IsChecked="{x:Bind ViewModel.IsOutputting, Mode=TwoWay}"/>
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
            <toolkit:SettingsCard
                Header="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.GamesPageText.StrengthModeCardHeader, Mode=OneWay}"
                Description="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.GamesPageText.StrengthModeCardDescription, Mode=OneWay}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9E9;"/>
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox
                    PlaceholderText="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.GamesPageText.StrengthModePlaceholderText, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.StrengthModeSelectionItems, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedStrengthMode, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:StrengthModeSelectionItem">
                            <TextBlock Text="{x:Bind Description}" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </toolkit:SettingsCard>
            <TextBlock
                Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,14,0,4"
                Text="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.GamesPageText.InternalGameItemsHeader, Mode=OneWay}"/>
            <toolkit:SettingsCard
                Header="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.GamesPageText.GtaVcGameplayHeader, Mode=OneWay}"
                Description="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.GamesPageText.GtaVcGameplayCardDescription, Mode=OneWay}"
                IsClickEnabled="True" Click="OnGameplayCardClick" Tag="{x:Bind GtaVcRuleCards}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE804;"/>
                </toolkit:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource CommonControlSpacing}">
                    <ProgressRing IsActive="{x:Bind GtaVcRuleCardViewModel.IsAccessing, Mode=OneWay}"/>
                    <ContentControl Content="{x:Bind GtaVcRuleCardViewModel.StateMessage, Mode=OneWay}" VerticalAlignment="Center">
                        <ContentControl.ContentTransitions>
                            <PaneThemeTransition Edge="Bottom"/>
                        </ContentControl.ContentTransitions>
                    </ContentControl>
                    <ToggleSwitch
                        IsOn="{x:Bind GtaVcRuleCardViewModel.IsEnabled, Mode=TwoWay}"
                        OnContent="{x:Null}" OffContent="{x:Null}" Margin="-8,0,0,0"/>
                </StackPanel>
            </toolkit:SettingsCard>
            <toolkit:SettingsExpander
                Header="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.GamesPageText.EmptyGameplayCardHeader, Mode=OneWay}">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE897;"/>
                </toolkit:SettingsExpander.HeaderIcon>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard
                        IsClickEnabled="True"
                        Header="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.GamesPageText.RepositoryLinkCardHeader, Mode=OneWay}">
                        <HyperlinkButton Content="https://github.com/exdian/Dianty/releases" NavigateUri="https://github.com/exdian/Dianty/releases" />
                        <toolkit:SettingsCard.ActionIcon>
                            <FontIcon Glyph="&#xE8A7;" />
                        </toolkit:SettingsCard.ActionIcon>
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
        </StackPanel>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinimalModeThresholdWidth}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootScrollViewer.Padding" Value="24,0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </ScrollViewer>
</UserControl>
