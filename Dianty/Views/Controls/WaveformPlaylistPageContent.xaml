<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Dianty.Views.Controls.WaveformPlaylistPageContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Dianty.Views.Controls"
    xmlns:txt="using:Dianty.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <local:WaveformPlaylistControl
            x:Name="ListViewA" Padding="12,0,12,20"
            Header="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.WaveformsPageText.ChannelAPlaylistSwitchHeader, Mode=OneWay}"
            IsChannelEnabled="{x:Bind ViewModel.IsChannelEnabledA, Mode=TwoWay}"
            WaveformPlayingItemsSource="{x:Bind ViewModel.WaveformPlayingItemsA}"
            PlaybackModeItemsSource="{x:Bind ViewModel.WaveformPlaybackModeSelectionItems}"
            SelectedPlaybackMode="{x:Bind ViewModel.SelectedWaveformPlaybackModeA, Mode=TwoWay}"
            WaveformIntervalItemsSource="{x:Bind ViewModel.WaveformSwitchIntervalItems}"
            SelectedWaveformInterval="{x:Bind ViewModel.SelectedWaveformIntervalA, Mode=TwoWay}"
            PlayWaveformCommand="{x:Bind ViewModel.PlayWaveformACommand}"
            RemoveWaveformCommand="{x:Bind ViewModel.RemovePlaylistWaveformItemACommand}"
            ClearPlayingItemsCommand="{x:Bind ViewModel.ClearPlayingItemsACommand}"/>
        <local:WaveformPlaylistControl
            x:Name="ListViewB" Grid.Column="1" Padding="12,0,12,20"
            Header="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.WaveformsPageText.ChannelBPlaylistSwitchHeader, Mode=OneWay}"
            IsChannelEnabled="{x:Bind ViewModel.IsChannelEnabledB, Mode=TwoWay}"
            WaveformPlayingItemsSource="{x:Bind ViewModel.WaveformPlayingItemsB}"
            PlaybackModeItemsSource="{x:Bind ViewModel.WaveformPlaybackModeSelectionItems}"
            SelectedPlaybackMode="{x:Bind ViewModel.SelectedWaveformPlaybackModeB, Mode=TwoWay}"
            WaveformIntervalItemsSource="{x:Bind ViewModel.WaveformSwitchIntervalItems}"
            SelectedWaveformInterval="{x:Bind ViewModel.SelectedWaveformIntervalB, Mode=TwoWay}"
            PlayWaveformCommand="{x:Bind ViewModel.PlayWaveformBCommand}"
            RemoveWaveformCommand="{x:Bind ViewModel.RemovePlaylistWaveformItemBCommand}"
            ClearPlayingItemsCommand="{x:Bind ViewModel.ClearPlayingItemsBCommand}"/>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinimalModeThresholdWidth}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ListViewA.Margin" Value="12,0,0,0"/>
                        <Setter Target="ListViewB.Margin" Value="0,0,12,0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
