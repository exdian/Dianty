<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Dianty.Views.Controls.GtaVcRuleCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Dianty.ViewModels"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <toolkit:SettingsExpander Header="侠盗飞车 罪恶都市" Description="包含6条规则">
        <toolkit:SettingsExpander.HeaderIcon>
            <FontIcon Glyph="&#xE804;"/>
        </toolkit:SettingsExpander.HeaderIcon>
        <ToggleSwitch IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}"/>
        <toolkit:SettingsExpander.Items>
            <toolkit:SettingsCard Header="此玩法的规则强度模式" Description="多条规则同时生效时">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9E9;"/>
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox
                    PlaceholderText="选择处理模式"
                    ItemsSource="{x:Bind ViewModel.StrengthModeSelectionItems}"
                    SelectedItem="{x:Bind ViewModel.StrengthMode, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:StrengthModeSelectionItem">
                            <TextBlock Text="{x:Bind Description}" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </toolkit:SettingsCard>
            <toolkit:SettingsCard>
                <toolkit:SettingsCard.Header>
                    <StackPanel Spacing="{StaticResource CommonCardSpacing}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="每累计受到伤害" Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center"/>
                            <NumberBox
                                SpinButtonPlacementMode="Inline" NumberFormatter="{StaticResource DecimalIntegerFormatter}"
                                Value="{x:Bind ViewModel.DamageRuleThreshold, Mode=TwoWay}"
                                SmallChange="1" LargeChange="20" Minimum="-200" Maximum="200"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="惩罚强度" Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center"/>
                            <NumberBox
                                SpinButtonPlacementMode="Inline" NumberFormatter="{StaticResource DecimalIntegerFormatter}"
                                Value="{x:Bind ViewModel.DamageRuleStrength, Mode=TwoWay}"
                                SmallChange="1" LargeChange="20" Minimum="-200" Maximum="200"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="持续时间（秒）" Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center"/>
                            <NumberBox
                                SpinButtonPlacementMode="Inline" NumberFormatter="{StaticResource DecimalIntegerFormatter}"
                                Value="{x:Bind ViewModel.DamageRuleDuration, Mode=TwoWay}"
                                SmallChange="1" LargeChange="10" Minimum="0" Maximum="200"/>
                        </StackPanel>
                    </StackPanel>
                </toolkit:SettingsCard.Header>
                <ToggleSwitch IsOn="{x:Bind ViewModel.DamageRuleEnabled, Mode=TwoWay}"/>
            </toolkit:SettingsCard>
            <toolkit:SettingsCard>
                <toolkit:SettingsCard.Header>
                    <StackPanel Spacing="{StaticResource CommonCardSpacing}">
                        <TextBlock Text="被捕时，每拥有1枚好市民勋章" Style="{StaticResource BodyTextBlockStyle}" Margin="0,7"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="惩罚强度" Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center"/>
                            <NumberBox
                                SpinButtonPlacementMode="Inline" NumberFormatter="{StaticResource DecimalIntegerFormatter}"
                                Value="{x:Bind ViewModel.BustedRuleStrength, Mode=TwoWay}"
                                SmallChange="1" LargeChange="20" Minimum="-200" Maximum="200"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="持续时间（秒）" Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center"/>
                            <NumberBox
                                SpinButtonPlacementMode="Inline" NumberFormatter="{StaticResource DecimalIntegerFormatter}"
                                Value="{x:Bind ViewModel.BustedRuleDuration, Mode=TwoWay}"
                                SmallChange="1" LargeChange="10" Minimum="0" Maximum="200"/>
                        </StackPanel>
                    </StackPanel>
                </toolkit:SettingsCard.Header>
                <ToggleSwitch IsOn="{x:Bind ViewModel.BustedRuleEnabled, Mode=TwoWay}"/>
            </toolkit:SettingsCard>
            <toolkit:SettingsCard>
                <toolkit:SettingsCard.Header>
                    <StackPanel Spacing="{StaticResource CommonCardSpacing}">
                        <TextBlock Text="血量为0时" Style="{StaticResource BodyTextBlockStyle}" Margin="0,7"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="惩罚强度" Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center"/>
                            <NumberBox
                                SpinButtonPlacementMode="Inline" NumberFormatter="{StaticResource DecimalIntegerFormatter}"
                                Value="{x:Bind ViewModel.WastedRuleStrength, Mode=TwoWay}"
                                SmallChange="1" LargeChange="20" Minimum="-200" Maximum="200"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="持续时间（秒）" Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center"/>
                            <NumberBox
                                SpinButtonPlacementMode="Inline" NumberFormatter="{StaticResource DecimalIntegerFormatter}"
                                Value="{x:Bind ViewModel.WastedRuleDuration, Mode=TwoWay}"
                                SmallChange="1" LargeChange="10" Minimum="0" Maximum="200"/>
                        </StackPanel>
                    </StackPanel>
                </toolkit:SettingsCard.Header>
                <ToggleSwitch IsOn="{x:Bind ViewModel.WastedRuleEnabled, Mode=TwoWay}"/>
            </toolkit:SettingsCard>
            <toolkit:SettingsCard>
                <toolkit:SettingsCard.Header>
                    <StackPanel Spacing="{StaticResource CommonCardSpacing}">
                        <TextBlock Text="变成米汤时" Style="{StaticResource BodyTextBlockStyle}" Margin="0,7"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="惩罚强度" Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center"/>
                            <NumberBox
                                SpinButtonPlacementMode="Inline" NumberFormatter="{StaticResource DecimalIntegerFormatter}"
                                Value="{x:Bind ViewModel.MiTangRuleStrength, Mode=TwoWay}"
                                SmallChange="1" LargeChange="20" Minimum="-200" Maximum="200"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="持续时间（秒）" Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center"/>
                            <NumberBox
                                SpinButtonPlacementMode="Inline" NumberFormatter="{StaticResource DecimalIntegerFormatter}"
                                Value="{x:Bind ViewModel.MiTangRuleDuration, Mode=TwoWay}"
                                SmallChange="1" LargeChange="10" Minimum="0" Maximum="200"/>
                        </StackPanel>
                    </StackPanel>
                </toolkit:SettingsCard.Header>
                <ToggleSwitch IsOn="{x:Bind ViewModel.MiTangRuleEnabled, Mode=TwoWay}"/>
            </toolkit:SettingsCard>
            <toolkit:SettingsCard>
                <toolkit:SettingsCard.Header>
                    <StackPanel Spacing="{StaticResource CommonCardSpacing}">
                        <TextBlock Text="每获得1枚好市民勋章" Style="{StaticResource BodyTextBlockStyle}" Margin="0,7"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="惩罚强度" Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center"/>
                            <NumberBox
                                SpinButtonPlacementMode="Inline" NumberFormatter="{StaticResource DecimalIntegerFormatter}"
                                Value="{x:Bind ViewModel.WantedLevelRuleStrength, Mode=TwoWay}"
                                SmallChange="1" LargeChange="20" Minimum="-200" Maximum="200"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="持续时间（秒）" Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center"/>
                            <NumberBox
                                SpinButtonPlacementMode="Inline" NumberFormatter="{StaticResource DecimalIntegerFormatter}"
                                Value="{x:Bind ViewModel.WantedLevelRuleDuration, Mode=TwoWay}"
                                SmallChange="1" LargeChange="10" Minimum="0" Maximum="200"/>
                        </StackPanel>
                    </StackPanel>
                </toolkit:SettingsCard.Header>
                <ToggleSwitch IsOn="{x:Bind ViewModel.WantedLevelRuleEnabled, Mode=TwoWay}"/>
            </toolkit:SettingsCard>
            <toolkit:SettingsCard>
                <toolkit:SettingsCard.Header>
                    <StackPanel Spacing="{StaticResource CommonCardSpacing}">
                        <TextBlock Text="从摩托车上摔下来时" Style="{StaticResource BodyTextBlockStyle}" Margin="0,7"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="惩罚强度" Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center"/>
                            <NumberBox
                                SpinButtonPlacementMode="Inline" NumberFormatter="{StaticResource DecimalIntegerFormatter}"
                                Value="{x:Bind ViewModel.FellOffBikeRuleStrength, Mode=TwoWay}"
                                SmallChange="1" LargeChange="20" Minimum="-200" Maximum="200"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="持续时间（秒）" Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center"/>
                            <NumberBox
                                SpinButtonPlacementMode="Inline" NumberFormatter="{StaticResource DecimalIntegerFormatter}"
                                Value="{x:Bind ViewModel.FellOffBikeRuleDuration, Mode=TwoWay}"
                                SmallChange="1" LargeChange="10" Minimum="0" Maximum="200"/>
                        </StackPanel>
                    </StackPanel>
                </toolkit:SettingsCard.Header>
                <ToggleSwitch IsOn="{x:Bind ViewModel.FellOffBikeRuleEnabled, Mode=TwoWay}"/>
            </toolkit:SettingsCard>
        </toolkit:SettingsExpander.Items>
    </toolkit:SettingsExpander>
</UserControl>
