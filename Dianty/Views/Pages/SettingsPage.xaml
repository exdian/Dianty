<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Dianty.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Dianty.ViewModels"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="PageHeader" Text="设置" Style="{StaticResource TitleTextBlockStyle}" Margin="12,6,12,12"/>
        <ScrollViewer x:Name="PageContent" Grid.Row="1" Padding="12,0" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
            <StackPanel Spacing="{StaticResource CommonCardSpacing}" Margin="0,0,0,24">
                <StackPanel.ChildrenTransitions>
                    <RepositionThemeTransition />
                </StackPanel.ChildrenTransitions>
                <TextBlock Text="外观" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,2,0,4"/>
                <toolkit:SettingsCard Header="应用主题">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;"/>
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox
                        PlaceholderText="选择应用主题" ItemsSource="{x:Bind ViewModel.AppThemeSelectionItems}"
                        SelectedItem="{x:Bind ViewModel.SelectedAppTheme, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AppThemeSelectionItem">
                                <TextBlock Text="{x:Bind Description}" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </toolkit:SettingsCard>
                <TextBlock Text="其他" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,14,0,4"/>
                <toolkit:SettingsExpander Header="其他设置" HeaderIcon="Setting">
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard Loaded="OnSettingsCardLoaded">
                            <TextBlock Text="不给设" HorizontalAlignment="Center" Margin="0,8.67"/>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
                <TextBlock Text="关于" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,14,0,4"/>
                <toolkit:SettingsExpander Header="Dianty">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <BitmapIcon ShowAsMonochrome="False" UriSource="Assets/AppIcon-48.png"/>
                    </toolkit:SettingsExpander.HeaderIcon>
                    <TextBlock Text="{x:Bind ViewModel.Version}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard Header="查看源代码" IsClickEnabled="True">
                            <HyperlinkButton Content="https://github.com/exdian/Dianty" NavigateUri="https://github.com/exdian/Dianty" />
                            <toolkit:SettingsCard.ActionIcon>
                                <FontIcon Glyph="&#xE8A7;" />
                            </toolkit:SettingsCard.ActionIcon>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Header="依赖和引用" ContentAlignment="Vertical" HorizontalContentAlignment="Left">
                            <StackPanel Margin="-12,0,0,0">
                                <HyperlinkButton Content="Windows App SDK, Windows App Runtime" NavigateUri="https://aka.ms/windowsappsdk" />
                                <HyperlinkButton Content="WinUI 3" NavigateUri="https://aka.ms/winui" />
                                <HyperlinkButton Content="Windows Community Toolkit (Windows)" NavigateUri="https://github.com/CommunityToolkit/Windows" />
                                <HyperlinkButton Content="Windows Community Toolkit (.NET)" NavigateUri="https://github.com/CommunityToolkit/dotnet" />
                                <HyperlinkButton Content="SimpleMem" NavigateUri="https://github.com/hburn7/SimpleMem" />
                                <HyperlinkButton Content="QRCoder" NavigateUri="https://github.com/Shane32/QRCoder" />
                            </StackPanel>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Header="部分代码参考了 WinUI 3 Gallery" ContentAlignment="Vertical" HorizontalContentAlignment="Left">
                            <HyperlinkButton Content="WinUI-Gallery" NavigateUri="https://github.com/microsoft/WinUI-Gallery" Margin="-12,0,0,0"/>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Header="引用的其他项目" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                            <TreeView SelectionMode="None" CanDragItems="False" CanReorderItems="False" ItemInvoked="OnTreeViewItemInvoked">
                                <TreeView.ItemContainerTransitions>
                                    <TransitionCollection>
                                        <PaneThemeTransition Edge="Top"/>
                                        <RepositionThemeTransition />
                                    </TransitionCollection>
                                </TreeView.ItemContainerTransitions>
                                <TreeView.RootNodes>
                                    <TreeViewNode Content="DiantyCore" IsExpanded="True">
                                        <TreeViewNode.Children>
                                            <TreeViewNode Content="DungeonToolkit">
                                                <TreeViewNode.Children>
                                                    <TreeViewNode Content="依赖项">
                                                        <TreeViewNode.Children>
                                                            <TreeViewNode Content=".NET 10.0"/>
                                                        </TreeViewNode.Children>
                                                    </TreeViewNode>
                                                </TreeViewNode.Children>
                                            </TreeViewNode>
                                            <TreeViewNode Content="GameMonitor">
                                                <TreeViewNode.Children>
                                                    <TreeViewNode Content="依赖项">
                                                        <TreeViewNode.Children>
                                                            <TreeViewNode Content=".NET 10.0"/>
                                                        </TreeViewNode.Children>
                                                    </TreeViewNode>
                                                </TreeViewNode.Children>
                                            </TreeViewNode>
                                        </TreeViewNode.Children>
                                    </TreeViewNode>
                                    <TreeViewNode Content="备注：DiantyCore 仓库暂未公开"/>
                                </TreeView.RootNodes>
                            </TreeView>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
            </StackPanel>
        </ScrollViewer>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinimalModeThresholdWidth}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- NavigationView.DisplayMode != Minimal -->
                        <Setter Target="PageHeader.Margin" Value="24,12"/>
                        <Setter Target="PageContent.Padding" Value="24,0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
