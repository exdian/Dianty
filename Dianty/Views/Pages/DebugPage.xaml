<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Dianty.Views.Pages.DebugPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:msg="using:Dianty.Utils.Messages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button x:Name="ClearButton" Grid.Row="0" Margin="12,12,12,0"
                Command="{x:Bind ViewModel.ClearLogCommand}" Content="清空日志" />

        <ListView
            x:Name="_logListView" Grid.Row="1" Padding="9,0"
            SelectionMode="Extended" ItemsSource="{x:Bind ViewModel.Logs}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="msg:Log">
                    <TextBlock 
                        Text="{x:Bind ToString()}" FontFamily="Consolas, Courier New, monospace"
                        TextWrapping="Wrap" Margin="0,10"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinimalModeThresholdWidth}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- NavigationView.DisplayMode != Minimal -->
                        <Setter Target="ClearButton.Margin" Value="24,24,24,0"/>
                        <Setter Target="_logListView.Padding" Value="21,0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
