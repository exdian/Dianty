<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Dianty.Views.Pages.WavePlayingQueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Dianty.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid ColumnSpacing="{StaticResource CommonControlSpacing}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <BreadcrumbBar
            x:Name="PageHeader" Grid.ColumnSpan="2" ItemsSource="{x:Bind Paths}" Margin="12,6,12,12"
            ItemClicked="OnBreadcrumbBarItemClicked">
            <BreadcrumbBar.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{x:Bind}" Style="{StaticResource TitleTextBlockStyle}"/>
                </DataTemplate>
            </BreadcrumbBar.ItemTemplate>
        </BreadcrumbBar>
        <controls:WavePlayingQueueListView
            x:Name="ListViewA" Grid.Row="1" Padding="12,0,12,20" Header="A通道队列"
            IsChannelEnabled="{x:Bind ViewModel.IsChannelEnabledA, Mode=TwoWay}"
            WavePlayingItemsSource="{x:Bind ViewModel.WavePlayingItemsA}"
            PlayingModeItemsSource="{x:Bind ViewModel.WavePlayingModeItems}"
            SelectedPlayingMode="{x:Bind ViewModel.WavePlayingModeA, Mode=TwoWay}"
            WaveIntervalItemsSource="{x:Bind ViewModel.WaveIntervalItems}"
            SelectedWaveInterval="{x:Bind ViewModel.WaveIntervalA, Mode=TwoWay}"
            PlayWaveCommand="{x:Bind ViewModel.PlayWaveACommand}"
            RemoveWaveCommand="{x:Bind ViewModel.RemovePlayingItemACommand}"/>
        <controls:WavePlayingQueueListView
            x:Name="ListViewB" Grid.Row="1" Grid.Column="1" Padding="0,0,12,20" Header="B通道队列"
            IsChannelEnabled="{x:Bind ViewModel.IsChannelEnabledB, Mode=TwoWay}"
            WavePlayingItemsSource="{x:Bind ViewModel.WavePlayingItemsB}"
            PlayingModeItemsSource="{x:Bind ViewModel.WavePlayingModeItems}"
            SelectedPlayingMode="{x:Bind ViewModel.WavePlayingModeB, Mode=TwoWay}"
            WaveIntervalItemsSource="{x:Bind ViewModel.WaveIntervalItems}"
            SelectedWaveInterval="{x:Bind ViewModel.WaveIntervalB, Mode=TwoWay}"
            PlayWaveCommand="{x:Bind ViewModel.PlayWaveBCommand}"
            RemoveWaveCommand="{x:Bind ViewModel.RemovePlayingItemBCommand}"/>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinimalModeThresholdWidth}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- NavigationView.DisplayMode != Minimal -->
                        <Setter Target="PageHeader.Margin" Value="24,12,24,12"/>
                        <Setter Target="ListViewA.Padding" Value="24,0,12,20"/>
                        <Setter Target="ListViewB.Padding" Value="0,0,24,20"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
