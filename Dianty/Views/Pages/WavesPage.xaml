<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Dianty.Views.Pages.WavesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Dianty.ViewModels"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:txt="using:Dianty.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="NormalWaveItemTemplate" x:DataType="vm:WaveItem">
            <toolkit:SettingsCard
                Header="{x:Bind Name, Mode=OneWay}" Description="{x:Bind Description}" Margin="0,0,0,4"
                IsClickEnabled="True" Click="OnWaveItemCardClick">
                <toolkit:SettingsCard.HeaderIcon>
                    <PathIcon
                        Data="M28.072 35.719c.387-.188.697-.504.932-.949L35.156 22.5H42.75c.609 0 1.137-.222 1.582-.668.445-.445.668
                        -.972.668-1.582 0-.609-.223-1.137-.668-1.582S43.359 18 42.75 18h-9c-.399 0-.786.112-1.16.334-.375.223-.657
                        .522-.844.896l-4.184 8.333L20.18 1.617c-.141-.468-.422-.855-.844-1.16C18.914.153 18.457 0 17.965 0c-.469 0
                        -.891.135-1.266.404-.375.27-.645.616-.808 1.037L9.703 18H2.25c-.61 0-1.137.223-1.582.668C.222 19.113 0 19.641
                        0 20.25c0 .61.222 1.137.668 1.582.445.446.972.668 1.582.668h9c.469 0 .896-.135 1.283-.404.387-.269.662-.627
                        .826-1.073l4.36-11.601 7.136 24.961c.117.399.358.768.721 1.107.363.34.768.51 1.213.51.469 0 .897-.093 1.283-.281Z"/>
                </toolkit:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource CommonControlSpacing}">
                    <ToggleButton
                        Content="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.WavesPageText.ChannelALabel, Mode=OneWay}"
                        IsChecked="{x:Bind IsEnabledA, Mode=TwoWay}"/>
                    <ToggleButton
                        Content="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.WavesPageText.ChannelBLabel, Mode=OneWay}"
                        IsChecked="{x:Bind IsEnabledB, Mode=TwoWay}"/>
                </StackPanel>
            </toolkit:SettingsCard>
        </DataTemplate>
        <DataTemplate x:Key="SortWaveItemTemplate" x:DataType="vm:WaveItem">
            <toolkit:SettingsCard Header="{x:Bind Name, Mode=OneWay}" Description="{x:Bind Description}" Margin="0,0,0,4">
                <toolkit:SettingsCard.HeaderIcon>
                    <PathIcon
                        Data="M28.072 35.719c.387-.188.697-.504.932-.949L35.156 22.5H42.75c.609 0 1.137-.222 1.582-.668.445-.445.668
                        -.972.668-1.582 0-.609-.223-1.137-.668-1.582S43.359 18 42.75 18h-9c-.399 0-.786.112-1.16.334-.375.223-.657
                        .522-.844.896l-4.184 8.333L20.18 1.617c-.141-.468-.422-.855-.844-1.16C18.914.153 18.457 0 17.965 0c-.469 0
                        -.891.135-1.266.404-.375.27-.645.616-.808 1.037L9.703 18H2.25c-.61 0-1.137.223-1.582.668C.222 19.113 0 19.641
                        0 20.25c0 .61.222 1.137.668 1.582.445.446.972.668 1.582.668h9c.469 0 .896-.135 1.283-.404.387-.269.662-.627
                        .826-1.073l4.36-11.601 7.136 24.961c.117.399.358.768.721 1.107.363.34.768.51 1.213.51.469 0 .897-.093 1.283-.281Z"/>
                </toolkit:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource CommonControlSpacing}">
                    <ToggleButton
                        Content="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.WavesPageText.ChannelALabel, Mode=OneWay}"
                        IsChecked="{x:Bind IsEnabledA, Mode=TwoWay}"/>
                    <ToggleButton
                        Content="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.WavesPageText.ChannelBLabel, Mode=OneWay}"
                        IsChecked="{x:Bind IsEnabledB, Mode=TwoWay}"/>
                </StackPanel>
            </toolkit:SettingsCard>
        </DataTemplate>
        <DataTemplate x:Key="DeletionWaveItemTemplate" x:DataType="vm:WaveItem">
            <toolkit:SettingsCard Header="{x:Bind Name, Mode=OneWay}" Description="{x:Bind Description}" Margin="0,0,0,4">
                <toolkit:SettingsCard.HeaderIcon>
                    <PathIcon
                        Data="M28.072 35.719c.387-.188.697-.504.932-.949L35.156 22.5H42.75c.609 0 1.137-.222 1.582-.668.445-.445.668
                        -.972.668-1.582 0-.609-.223-1.137-.668-1.582S43.359 18 42.75 18h-9c-.399 0-.786.112-1.16.334-.375.223-.657
                        .522-.844.896l-4.184 8.333L20.18 1.617c-.141-.468-.422-.855-.844-1.16C18.914.153 18.457 0 17.965 0c-.469 0
                        -.891.135-1.266.404-.375.27-.645.616-.808 1.037L9.703 18H2.25c-.61 0-1.137.223-1.582.668C.222 19.113 0 19.641
                        0 20.25c0 .61.222 1.137.668 1.582.445.446.972.668 1.582.668h9c.469 0 .896-.135 1.283-.404.387-.269.662-.627
                        .826-1.073l4.36-11.601 7.136 24.961c.117.399.358.768.721 1.107.363.34.768.51 1.213.51.469 0 .897-.093 1.283-.281Z"/>
                </toolkit:SettingsCard.HeaderIcon>
                <Button Click="OnWaveItemDeletionButtonClickA" CommandParameter="{x:Bind}">
                    <SymbolIcon Symbol="Delete"/>
                </Button>
            </toolkit:SettingsCard>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            x:Name="_pageHeader" Style="{StaticResource TitleTextBlockStyle}" Margin="12,6,12,12"
            Text="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.MenuWaves, Mode=OneWay}"/>
        <ListView
            x:Name="_pageContent" Grid.Row="1" Padding="12,0,12,20" SelectionMode="None" CanReorderItems="True" AllowDrop="True"
            ItemsSource="{x:Bind ViewModel.WaveItems}" ItemContainerStyle="{StaticResource StretchListViewItemStyle}"
            ItemTemplate="{StaticResource NormalWaveItemTemplate}">
            <ListView.Header>
                <Grid x:Name="ListViewHeader" Margin="0,0,0,8">
                    <Grid.Resources>
                        <Thickness x:Key="ToggleSwitchTopHeaderMargin">0</Thickness>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleSwitch
                        IsOn="{x:Bind ViewModel.IsChannelEnabledA, Mode=TwoWay}" MinWidth="0"
                        Header="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.WavesPageText.ChannelAQueueSwitchHeader, Mode=OneWay}"
                        OffContent="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.ToggleSwitchText.OffText, Mode=OneWay}"
                        OnContent="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.ToggleSwitchText.OnText, Mode=OneWay}"/>
                    <ToggleSwitch
                        Grid.Column="1" IsOn="{x:Bind ViewModel.IsChannelEnabledB, Mode=TwoWay}"
                        Header="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.WavesPageText.ChannelBQueueSwitchHeader, Mode=OneWay}"
                        OffContent="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.ToggleSwitchText.OffText, Mode=OneWay}"
                        OnContent="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.ToggleSwitchText.OnText, Mode=OneWay}"/>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="{StaticResource CommonControlSpacing}">
                        <Button
                            Content="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.WavesPageText.ImportWaveButtonText, Mode=OneWay}"
                            Command="{x:Bind ViewModel.ImportWaveCommand}" CommandParameter="{x:Bind XamlRoot.ContentIslandEnvironment.AppWindowId}"/>
                        <ToggleButton
                            x:Name="_deletionButton" Click="OnDeletionButtonClick"
                            Content="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.WavesPageText.DeleteButtonText, Mode=OneWay}"/>
                    </StackPanel>
                    <StackPanel
                        x:Name="SortAndQueueButton" Grid.Row="1" Grid.ColumnSpan="2"
                        Orientation="Horizontal" Spacing="{StaticResource CommonControlSpacing}" HorizontalAlignment="Right">
                        <ToggleButton
                            x:Name="_sortButton" Click="OnSortButtonClick"
                            Content="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.WavesPageText.SortButtonText, Mode=OneWay}"/>
                        <Button
                            Content="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.WavesPageText.QueueButtonText, Mode=OneWay}"
                            Click="OnQueueButtonClick"/>
                    </StackPanel>
                </Grid>
            </ListView.Header>
        </ListView>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinimalModeThresholdWidth}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- NavigationView.DisplayMode != Minimal -->
                        <Setter Target="_pageHeader.Margin" Value="24,12"/>
                        <Setter Target="_pageContent.Padding" Value="24,0,24,20"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger MaxWidth="290" TargetElement="{x:Bind ListViewHeader}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SortAndQueueButton.(Grid.Row)" Value="2"/>
                        <Setter Target="SortAndQueueButton.HorizontalAlignment" Value="Left"/>
                        <Setter Target="SortAndQueueButton.Margin" Value="0,8,0,0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
