<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Dianty.Views.Pages.WavesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Dianty.ViewModels"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="_pageHeader" Text="波形" Style="{StaticResource TitleTextBlockStyle}" Margin="12,6,12,12"/>
        <ListView
            x:Name="PageContent" Grid.Row="1" Padding="12,0,12,20" SelectionMode="None"
            ItemsSource="{x:Bind ViewModel.WaveItems}" ItemContainerStyle="{StaticResource StretchListViewItemStyle}">
            <ListView.Header>
                <Grid ColumnSpacing="{StaticResource CommonControlSpacing}" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="导入波形"/>
                    <Button Grid.Column="1" Content="播放队列" HorizontalAlignment="Right"/>
                </Grid>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:WaveItem">
                    <toolkit:SettingsCard Header="{x:Bind Name, Mode=OneWay}" Description="{x:Bind Description}" Margin="0,0,0,4">
                        <toolkit:SettingsCard.HeaderIcon>
                            <PathIcon
                                Data="M28.072 35.719c.387-.188.697-.504.932-.949L35.156 22.5H42.75c.609 0 1.137-.222 1.582-.668.445-.445.668
                                -.972.668-1.582 0-.609-.223-1.137-.668-1.582S43.359 18 42.75 18h-9c-.399 0-.786.112-1.16.334-.375.223-.657
                                .522-.844.896l-4.184 8.333L20.18 1.617c-.141-.468-.422-.855-.844-1.16C18.914.153 18.457 0 17.965 0c-.469 0
                                -.891.135-1.266.404-.375.27-.645.616-.808 1.037L9.703 18H2.25c-.61 0-1.137.223-1.582.668C.222 19.113 0 19.641
                                0 20.25c0 .61.222 1.137.668 1.582.445.446.972.668 1.582.668h9c.469 0 .896-.135 1.283-.404.387-.269.662-.627
                                .826-1.073l4.36-11.601 7.136 24.961c.117.399.358.768.721 1.107.363.34.768.51 1.213.51.469 0 .897-.093 1.283-.281Z"/>
                        </toolkit:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource CommonControlSpacing}">
                            <ToggleButton
                                Content="A通道" IsChecked="{x:Bind IsEnabledA, Mode=TwoWay}"
                                Click="OnToggleButtonClickA" CommandParameter="{x:Bind}"/>
                            <ToggleButton
                                Content="B通道" IsChecked="{x:Bind IsEnabledB, Mode=TwoWay}"
                                Click="OnToggleButtonClickB" CommandParameter="{x:Bind}"/>
                        </StackPanel>
                    </toolkit:SettingsCard>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinimalModeThresholdWidth}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- NavigationView.DisplayMode != Minimal -->
                        <Setter Target="_pageHeader.Margin" Value="24,12"/>
                        <Setter Target="PageContent.Padding" Value="24,0,24,20"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
