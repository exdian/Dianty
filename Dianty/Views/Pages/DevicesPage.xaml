<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Dianty.Views.Pages.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Dianty.ViewModels"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls="using:Dianty.Views.Controls"
    xmlns:txt="using:Dianty.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- 使用模板选择器会导致拖动数据项排序时，从其他位置拖动到第一行的插入动画会丢失。
        这可能不是模板选择器的问题，而是列表控件对同一个数据项多次调用模板选择器的原因 -->
        <DataTemplate x:Key="CoyoteItemTemplate" x:DataType="vm:CoyoteItemBase">
            <toolkit:SettingsCard
                Header="{x:Bind Name}"
                IsClickEnabled="{x:Bind IsClickEnabled, Mode=OneWay}" Click="OnDeviceItemCardClick" Margin="0,0,0,4">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="{x:Bind ConnectionKind, Converter={StaticResource ConnectionKindIconConverter}}"/>
                </toolkit:SettingsCard.HeaderIcon>
                <toolkit:SettingsCard.Description>
                    <TextBlock>
                        <Run Text="{x:Bind ConnectionKindDescription, Mode=OneWay}"/><Run Text=" - "/><Run Text="{x:Bind ConnectionMessage, Mode=OneWay}"/>
                    </TextBlock>
                </toolkit:SettingsCard.Description>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <SplitButton
                        Padding="0" Visibility="{x:Bind ConnectionKind, Converter={StaticResource VisibleIfBluetoothConverter}}"
                        Click="OnColorSplitButtonClick">
                        <Border
                            Width="{ThemeResource SplitButtonPrimaryButtonSize}" Height="32"
                            Background="{x:Bind LightsColor, Mode=OneWay, Converter={StaticResource DeviceLightsColorBrushConverter}}"
                            CornerRadius="4,0,0,4" BorderThickness="{ThemeResource SplitButtonBorderThemeThickness}"/>
                        <SplitButton.Flyout>
                            <Flyout Placement="Bottom">
                                <GridView
                                    ItemsSource="{x:Bind vm:CoyoteItemBase.LightsColors}" SelectedItem="{x:Bind LightsColor, Mode=OneWay}"
                                    IsItemClickEnabled="True" ItemClick="OnLightsColorSelectionItemClick" Padding="0">
                                    <GridView.ItemTemplate>
                                        <DataTemplate>
                                            <Rectangle
                                                Fill="{Binding Converter={StaticResource DeviceLightsColorBrushConverter}}"
                                                Width="28" Height="28" RadiusX="4" RadiusY="4"/>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                    <GridView.ItemContainerStyle>
                                        <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                                            <Setter Property="Margin" Value="2"/>
                                            <Setter Property="MinWidth" Value="36"/>
                                            <Setter Property="MinHeight" Value="36"/>
                                        </Style>
                                    </GridView.ItemContainerStyle>
                                </GridView>
                            </Flyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                    <ToggleSwitch
                        IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                        OffContent="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.ToggleSwitchText.OffText, Mode=OneWay}"
                        OnContent="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.ToggleSwitchText.OnText, Mode=OneWay}"/>
                </StackPanel>
            </toolkit:SettingsCard>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            x:Name="PageHeader" Style="{StaticResource TitleTextBlockStyle}" Margin="12,6,12,12"
            Text="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.MenuDevices, Mode=OneWay}"/>
        <ListView
            x:Name="PageContent" Grid.Row="1" Padding="12,0,12,20" SelectionMode="None" CanReorderItems="True" AllowDrop="True"
            ItemsSource="{x:Bind ViewModel.CoyoteItems}" ItemContainerStyle="{StaticResource StretchListViewItemStyle}"
            ItemTemplate="{StaticResource CoyoteItemTemplate}">
            <ListView.Header>
                <Grid Margin="0,0,0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource CommonControlSpacing}">
                        <StackPanel.ChildrenTransitions>
                            <RepositionThemeTransition/>
                        </StackPanel.ChildrenTransitions>
                        <DropDownButton
                            Content="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.DevicesPageText.AddDeviceButtonText, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsConnecting, Mode=OneWay, Converter={StaticResource VisibleIfFalseConverter}}">
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuFlyoutItem
                                        Text="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.DevicesPageText.BluetoothLabel, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.ConnectBleCommand}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE702;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        Text="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.DevicesPageText.SocketLabel, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.ConnectWsCommand}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE753;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <Button
                            Content="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.DevicesPageText.CancelButtonText, Mode=OneWay}"
                            Command="{x:Bind ViewModel.CancelConnectCommand}"
                            Visibility="{x:Bind ViewModel.IsConnecting, Mode=OneWay, Converter={StaticResource VisibleIfTrueConverter}}"/>
                        <controls:QrCodeButton
                            IsDisplayed="{x:Bind ViewModel.IsQrCodeDisplayed, Mode=OneWay}"
                            QrCodeGeometry="{x:Bind ViewModel.QrCodeSvgPath, Mode=OneWay, Converter={StaticResource SvgPathConverter}}"
                            Visibility="{x:Bind ViewModel.CanShowQrCode, Mode=OneWay, Converter={StaticResource VisibleIfTrueConverter}}"/>
                        <ProgressRing
                            IsActive="{x:Bind ViewModel.IsConnecting, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsConnecting, Mode=OneWay, Converter={StaticResource VisibleIfTrueConverter}}"/>
                        <ContentControl Content="{x:Bind ViewModel.ConnectionMessage, Mode=OneWay}" VerticalAlignment="Center">
                            <ContentControl.ContentTransitions>
                                <PaneThemeTransition Edge="Bottom"/>
                            </ContentControl.ContentTransitions>
                        </ContentControl>
                    </StackPanel>
                    <ToggleButton
                        x:Name="_sortButton" Grid.Row="1" HorizontalAlignment="Left" Margin="0,5,0,0"
                        Command="{x:Bind ViewModel.SwitchSortingCommand}" Unloaded="OnSortButtonUnloaded"
                        Content="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.DevicesPageText.SortButtonText, Mode=OneWay}"/>
                </Grid>
            </ListView.Header>
        </ListView>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinimalModeThresholdWidth}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageHeader.Margin" Value="24,12"/>
                        <Setter Target="PageContent.Padding" Value="24,0,24,20"/>
                        <Setter Target="_sortButton.HorizontalAlignment" Value="Right"/>
                        <Setter Target="_sortButton.Margin" Value="0"/>
                        <Setter Target="_sortButton.(Grid.Row)" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
