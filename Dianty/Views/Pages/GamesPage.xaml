<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Dianty.Views.Pages.GamesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Dianty.ViewModels"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:txt="using:Dianty.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            x:Name="PageHeader" Style="{StaticResource TitleTextBlockStyle}" Margin="12,6,12,12"
            Text="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.MenuGames, Mode=OneWay}"/>
        <ScrollViewer
            x:Name="PageContent" Grid.Row="1" Padding="12,0"
            VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
            <StackPanel x:Name="_gamesPageStackPanel" Spacing="{StaticResource CommonCardSpacing}" Margin="0,0,0,24" Loaded="StackPanel_Loaded">
                <StackPanel.ChildrenTransitions>
                    <RepositionThemeTransition />
                </StackPanel.ChildrenTransitions>
                <TextBlock
                    Text="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.GamesPageText.OverviewItemsHeader, Mode=OneWay}"
                    Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,2,0,4"/>
                <Grid
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefault}"
                    BorderBrush="{ThemeResource CardStrokeColorDefault}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}">
                    <Grid.Shadow>
                        <ThemeShadow />
                    </Grid.Shadow>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.GamesPageText.EnabledGameCountLabel, Mode=OneWay}" />
                    <TextBlock
                        Grid.Row="1" Grid.Column="0"
                        Text="{x:Bind ViewModel.EnabledGameCount, Mode=OneWay}"
                        FontSize="20" FontWeight="Bold" />
                    <TextBlock
                        Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.GamesPageText.OutputStrengthLabel, Mode=OneWay}" />
                    <TextBlock
                        Grid.Row="1" Grid.Column="1"
                        Text="{x:Bind ViewModel.OutputStrength, Mode=OneWay}"
                        FontSize="20" FontWeight="Bold" />
                </Grid>
                <toolkit:SettingsExpander
                    Header="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.GamesPageText.OutputModeCardHeader, Mode=OneWay}"
                    Description="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.GamesPageText.OutputModeCardDescription, Mode=OneWay}">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE9F5;"/>
                    </toolkit:SettingsExpander.HeaderIcon>
                    <ComboBox
                        PlaceholderText="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.GamesPageText.OutputModePlaceholderText, Mode=OneWay}"
                        ItemsSource="{x:Bind ViewModel.AutoStartStopModeSelectionItems, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.IsAutoStartStopMode, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AutoStartStopModeSelectionItem">
                                <TextBlock Text="{x:Bind Description}" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard
                            Header="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.GamesPageText.ManualSwitchCardHeader, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.IsAutoStartStop, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE815;"/>
                            </toolkit:SettingsCard.HeaderIcon>
                            <ToggleButton
                                Content="&#xE7E8;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18"
                                IsChecked="{x:Bind ViewModel.IsOutputting, Mode=TwoWay}"/>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
                <toolkit:SettingsCard
                    Header="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.GamesPageText.StrengthModeCardHeader, Mode=OneWay}"
                    Description="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.GamesPageText.StrengthModeCardDescription, Mode=OneWay}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE9E9;"/>
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox
                        PlaceholderText="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.GamesPageText.StrengthModePlaceholderText, Mode=OneWay}"
                        ItemsSource="{x:Bind ViewModel.StrengthModeSelectionItems, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.GamesStrengthMode, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:StrengthModeSelectionItem">
                                <TextBlock Text="{x:Bind Description}" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </toolkit:SettingsCard>
                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,14,0,4"
                    Text="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.GamesPageText.RuleItemsHeader, Mode=OneWay}"/>
                <toolkit:SettingsExpander
                    Header="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.GamesPageText.EmptyRuleCardHeader, Mode=OneWay}">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE897;"/>
                    </toolkit:SettingsExpander.HeaderIcon>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard
                            IsClickEnabled="True"
                            Header="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.GamesPageText.RepositoryLinkCardHeader, Mode=OneWay}">
                            <HyperlinkButton Content="https://github.com/exdian/Dianty/releases" NavigateUri="https://github.com/exdian/Dianty/releases" />
                            <toolkit:SettingsCard.ActionIcon>
                                <FontIcon Glyph="&#xE8A7;" />
                            </toolkit:SettingsCard.ActionIcon>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
            </StackPanel>
        </ScrollViewer>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinimalModeThresholdWidth}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- NavigationView.DisplayMode != Minimal -->
                        <Setter Target="PageHeader.Margin" Value="24,12"/>
                        <Setter Target="PageContent.Padding" Value="24,0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
