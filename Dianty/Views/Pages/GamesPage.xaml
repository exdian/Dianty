<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Dianty.Views.Pages.GamesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="玩法" Style="{StaticResource TitleTextBlockStyle}"/>
        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel Spacing="4" Margin="0,0,0,24">
                <StackPanel.ChildrenTransitions>
                    <RepositionThemeTransition />
                </StackPanel.ChildrenTransitions>
                <TextBlock Text="概况" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,2,0,4"/>
                <Grid
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefault}"
                    BorderBrush="{ThemeResource CardStrokeColorDefault}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}">
                    <Grid.Shadow>
                        <ThemeShadow />
                    </Grid.Shadow>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Row="0" Grid.Column="0"
                        Text="生效玩法"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        Grid.Row="1" Grid.Column="0"
                        Text="{x:Bind ViewModel.EnableGameCount, Mode=OneWay}"
                        FontSize="20"
                        FontWeight="Bold" />
                    <TextBlock
                        Grid.Row="0" Grid.Column="1"
                        Text="输出强度"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        Grid.Row="1" Grid.Column="1"
                        Text="{x:Bind ViewModel.OutputStrength, Mode=OneWay}"
                        FontSize="20"
                        FontWeight="Bold" />
                </Grid>
                <toolkit:SettingsCard Header="强度模式" Description="多个玩法同时生效时">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE9E9;"/>
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox
                        PlaceholderText="选择处理模式"
                        ItemsSource="{x:Bind ViewModel.StrengthModes}"
                        SelectedItem="{x:Bind ViewModel.CurrentStrengthMode, Mode=TwoWay}"
                        DisplayMemberPath="DisplayName"
                        SelectedValuePath="Value" />
                </toolkit:SettingsCard>
                <TextBlock Text="规则设置" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,14,0,4"/>
                <toolkit:SettingsExpander Header="侠盗猎车手 罪恶都市" Description="包含6项规则">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE804;"/>
                    </toolkit:SettingsExpander.HeaderIcon>
                    <ToggleSwitch/>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard IsClickEnabled="True">
                            <toolkit:SettingsCard.Header>
                                <ScrollViewer
                                    VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto"
                                    VerticalScrollMode="Disabled" HorizontalScrollMode="Auto"
                                    Padding="0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="每损失" Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center"/>
                                        <NumberBox
                                            SpinButtonPlacementMode="Inline"
                                            Value="1" SmallChange="1" LargeChange="20" Minimum="-200" Maximum="200"/>
                                        <TextBlock Text="生命值，惩罚强度" Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center"/>
                                        <NumberBox
                                            SpinButtonPlacementMode="Inline"
                                            Value="1" SmallChange="1" LargeChange="20" Minimum="-200" Maximum="200"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </toolkit:SettingsCard.Header>
                            <ToggleSwitch/>
                            <toolkit:SettingsCard.ActionIcon>
                                <!-- 当 IsClickEnabled=True 时，有默认图标，此处替换为空白 -->
                                <PathIcon Data="M0 0L1 1"/>
                            </toolkit:SettingsCard.ActionIcon>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>

                <toolkit:SettingsExpander Header="敬请期待">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE897;"/>
                    </toolkit:SettingsExpander.HeaderIcon>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard Header="查看更新" IsClickEnabled="True">
                            <HyperlinkButton Content="https://github.com/exdian/Dianty" NavigateUri="https://github.com/exdian/Dianty" />
                            <toolkit:SettingsCard.ActionIcon>
                                <FontIcon Glyph="&#xE8A7;" />
                            </toolkit:SettingsCard.ActionIcon>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
