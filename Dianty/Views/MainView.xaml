<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Dianty.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:txt="using:Dianty.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid PointerPressed="RootElement_PointerPressed">
        <Grid
            MinHeight="48" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="56,0,144,0"
            Background="Transparent" PointerPressed="TitleBar_PointerPressed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Viewbox x:Name="_appIcon" Width="16" Height="16" Margin="40,0,0,0">
                <Path
                    Data="M50 0C40 0 30 0 21 3S6 12 3 21 0 40 0 50 0 70 3 79s9 15 18 18 19 3 29 3 20 0 29-3 15-9 18-18
                    3-19 3-29 0-20-3-29S88 6 79 3 60 0 50 0ZM28 57H43.375l.961-7.684L31 50l-1-7 15.223-.781L46.125 35
                    H27ZM64 57l1.595-8.774-14.214.729L50.375 57ZM68 35H53.125l-.857 6.858 14.621-.75ZM54.875 21 54 28
                    H69l6 3-5 29-4 4H49.5l-1 8L70 73.5 74 64l6 3-3 10-4 3-29-2-2.75-4L42.5 64H25l-3-2-2-30 6-4H47l1-8Z"
                    Fill="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
            </Viewbox>
            <TextBlock
                x:Name="_titleText" Grid.Column="1"
                Text="Dianty" Style="{StaticResource CaptionTextBlockStyle}" Margin="16,0,0,0"
                TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"/>
        </Grid>
        <NavigationView
            x:Name="_navView"
            Loaded="NavView_Loaded" Unloaded="NavView_Unloaded" ItemInvoked="NavView_ItemInvoked" BackRequested="NavView_BackRequested"
            LayoutUpdated="NavView_LayoutUpdated" PaneClosed="NavView_PaneChanged" PaneOpened="NavView_PaneChanged"
            OpenPaneLength="125" CompactModeThresholdWidth="{StaticResource MinimalModeThresholdWidth}" ExpandedModeThresholdWidth="750"
            IsBackEnabled="{x:Bind _contentFrame.CanGoBack, Mode=OneWay}">
            <NavigationView.Resources>
                <Thickness x:Key="NavigationViewContentMargin">0,48,0,0</Thickness>
                <Thickness x:Key="NavigationViewMinimalContentMargin">0,48,0,0</Thickness>
            </NavigationView.Resources>
            <Frame x:Name="_contentFrame" IsTabStop="True" Navigated="OnFrameNavigated"/>
            <NavigationView.MenuItems>
                <NavigationViewItem
                    Icon="Home" Tag="{x:Bind HomePage}"
                    Content="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.MenuHome, Mode=OneWay}"/>
                <NavigationViewItem
                    Tag="{x:Bind DevicesPage}"
                    Content="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.MenuDevices, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <PathIcon
                            Data="M0 20 20 0H84l20 20V146L84 166H20L0 146ZM10 26V52L22 64v38L10 114v26l16 16H78l16-16V
                            114L82 102V64L94 52V26L78 10H70v6H58V10H46v6H34V10H26ZM10 61v44l6-6V67ZM88 67V99l6 6V61Z"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Tag="{x:Bind WavesPage}"
                    Content="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.MenuWaves, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Tag="{x:Bind GamesPage}"
                    Content="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.MenuGames, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7FC;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Icon="ReportHacked" Tag="{x:Bind SafetyPage}"
                    Content="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.MenuSafety, Mode=OneWay}"/>
                <NavigationViewItem
                    x:Name="_debugMenuItem" Icon="Repair" Tag="{x:Bind DebugPage}"
                    Content="{x:Bind txt:Localizer.Instance.AppText.MainWindowText.MainViewText.MenuDebug, Mode=OneWay}"/>
            </NavigationView.MenuItems>
        </NavigationView>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <!-- 在小窗口尺寸下加载页面仍会触发 MinWindowWidth="{StaticResource MinimalModeThresholdWidth}" 的
                AdaptiveTrigger，即使不使用资源，直接写 MinWindowWidth="500"，问题也依旧存在，原因不明。
                但是加上另一个 MinWindowWidth="1" 的 AdaptiveTrigger 后问题解决了 -->
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinimalModeThresholdWidth}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- NavigationView.DisplayMode != Minimal -->
                        <Setter Target="_appIcon.Margin" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="ActivationGroup">
                <VisualState x:Name="Activated" />
                <VisualState x:Name="Deactivated">
                    <VisualState.Setters>
                        <Setter Target="_appIcon.Opacity" Value="{ThemeResource TitleBarDeactivatedOpacity}" />
                        <Setter Target="_titleText.Foreground" Value="{ThemeResource TitleBarDeactivatedForegroundBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
