<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Dianty.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="_titleBar" Margin="94,0,0,0"
            Title="Dianty" IsBackButtonVisible="False" IsPaneToggleButtonVisible="False">
            <TitleBar.Resources>
                <x:Double x:Key="TitleBarLeftHeaderPaddingWidth">0</x:Double>
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <FontIconSource Glyph="&#xE945;"/>
            </TitleBar.IconSource>
        </TitleBar>
        <NavigationView
            x:Name="_navView" Grid.RowSpan="2"
            Loaded="NavView_Loaded" SelectionChanged="NavView_SelectionChanged" BackRequested="NavView_BackRequested"
            LayoutUpdated="NavView_LayoutUpdated"
            OpenPaneLength="120" CompactModeThresholdWidth="500" ExpandedModeThresholdWidth="750"
            IsBackEnabled="{x:Bind _contentFrame.CanGoBack, Mode=OneWay}">
            <NavigationView.Resources>
                <Thickness x:Key="NavigationViewContentMargin">0,48,0,0</Thickness>
                <Thickness x:Key="NavigationViewMinimalContentMargin">0,48,0,0</Thickness>
            </NavigationView.Resources>
            <Frame x:Name="_contentFrame" IsTabStop="True" Navigated="ContentFrame_Navigated" Margin="12,0"/>
            <NavigationView.MenuItems>
                <NavigationViewItem Icon="Home" Content="主页" Tag="{x:Bind HomePage}"/>
                <NavigationViewItem Content="设备" Tag="{x:Bind DevicesPage}">
                    <NavigationViewItem.Icon>
                        <PathIcon
                            Data="M0 20 20 0H84l20 20V146L84 166H20L0 146ZM10 26V52L22 64v38L10 114v26l16 16H78l16-16V
                            114L82 102V64L94 52V26L78 10H70v6H58V10H46v6H34V10H26ZM10 61v44l6-6V67ZM88 67V99l6 6V61Z"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="波形" Tag="{x:Bind WavesPage}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="玩法" Tag="{x:Bind GamesPage}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7FC;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Icon="ReportHacked" Content="安全" Tag="{x:Bind SafetyPage}"/>
            </NavigationView.MenuItems>
        </NavigationView>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{x:Bind _navView.CompactModeThresholdWidth}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- NavigationView.DisplayMode != Minimal -->
                        <Setter Target="_titleBar.Margin" Value="54,0,0,0"/>
                        <Setter Target="_contentFrame.Margin" Value="24,0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
